{
  "manifestVersion": 2,
  "name": "codex-proxy-basispoints",
  "displayName": "Basis Points Responses",
  "publisher": "david1989sky",
  "version": "0.1.11",
  "description": "Codex Proxy RS Basis Points Responses companion 插件",
  "license": "Apache-2.0",
  "author": "david1989sky",
  "engines": {
    "codex-proxy-rs": ">=3.18.1, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {},
    "middleware": {
      "version": 3,
      "stages": ["request"],
      "inputFormats": ["openai"],
      "outputFormats": ["openai"]
    }
  },
  "configurationSchema": {
    "type": "object",
    "properties": {
      "enabled": {"type": "boolean"},
      "models": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    },
    "additionalProperties": false
  }
}
