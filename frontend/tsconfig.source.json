{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "incremental": false,
    "composite": false,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "@codex-proxy/ui": [
        "../../../../ui/src/index.ts"
      ],
      "@codex-proxy/ui/theme": [
        "../../../../ui/src/theme/index.ts"
      ],
      "@codex-proxy/ui/*": [
        "../../../../ui/src/components/*/index.ts"
      ]
    }
  }
}
